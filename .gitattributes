# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
bin/strata text eol=lf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text

# the quant yardstick's text set: tokenized byte for byte (set.ids.json), never convert its line endings
data/quant_quality/** -text

# the license text is shipped and checked as LF text on every checkout
LICENSE text eol=lf

# container scripts run in Linux: always LF
docker/*.sh text eol=lf
Dockerfile text eol=lf
docker/Dockerfile text eol=lf
docker/compose/* text eol=lf

# Apple tools (codesign, plutil) read these: LF only, wherever the repository is cloned
*.plist text eol=lf

# vendored KaTeX (serve/web/vendor): the files are hashed byte for byte (PROVENANCE.json), never convert their line endings.
serve/web/vendor/** -text

# Archived measurements and inputs have byte-level dataset-manifest hashes.
bench/results/2026-11-04-community-ryzen-ai-max395-engine0156/** -text

# Current measurements preserve the published dataset hashes byte for byte.
bench/results/2026-11-04-community-ryzen-ai-max395-current-performance/** -text

# The Linux service and the patch distributed to IVYUN use LF on every checkout.
deploy/public-chat/tunnel-recovery/* text eol=lf
deploy/public-chat/*.patch text eol=lf

# The IVYUN source update carries a byte-level installation manifest.
deploy/public-chat/harness/files/** -text whitespace=cr-at-eol

# Protocol test inputs and responses retain the archived byte hashes.
deploy/windows-gfx1151/tool-protocol-validation-20261113/** -text whitespace=cr-at-eol

# Preserve the byte hashes of the DM16 benchmark inputs and results.
bench/results/2026-11-13-community-ryzen-ai-max395-dm16/** -text

# Keep reliability measurements and archived source patches byte-for-byte.
deploy/windows-gfx1151/reliability-validation-20261113/** -text -whitespace
