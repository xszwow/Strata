+
+test('Stop before the client attaches cancels an existing resumed task and preserves failed acknowledgement', async () => {
+    for (const reachable of [true, false]) {
+        const controller = new AbortController();
+        controller.abort();
+        const calls = [];
+        let confirmed;
+        const api = client(async (url, options) => {
+            calls.push({ url, body: JSON.parse(options.body) });
+            if (!reachable) throw new TypeError('offline');
+            return Response.json({ stopped: true });
+        });
+        await assert.rejects(api.generate([], {
+            generationId: 'saved-task',
+            resume: true,
+            signal: controller.signal,
+            onCancellation: value => { confirmed = value; }
+        }), error => error.name === 'AbortError');
+        assert.equal(confirmed, reachable);
+        assert.deepEqual(calls, [{
+            url: '/api/chat/cancel',
+            body: { generationId: 'saved-task' }
+        }]);
+    }
+});
