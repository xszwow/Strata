--- /dev/null
+++ b/public/js/core/svg-artifacts.js
@@ -0,0 +1,149 @@
+// Render model SVG as an image document: styles and IDs cannot affect the chat.
+// The downloadable SVG is sanitized too; the original remains available as text.
+const SvgArtifacts = {
+    limit: 256 * 1024,
+    matches(lang, source) {
+        return lang === 'svg' || (lang === 'xml' && /^\s*(?:<\?xml[^?]*\?>\s*)?<svg(?:\s|>)/i.test(source));
+    },
+    prepare(source) {
+        if (new TextEncoder().encode(source).length > this.limit)
+            throw new Error('SVG 超过 256 KiB，请拆分后再预览。');
+        if (/<!DOCTYPE|<!ENTITY/i.test(source)) throw new Error('SVG 不支持文档类型或实体声明。');
+        const parsed = new DOMParser().parseFromString(source, 'image/svg+xml');
+        if (parsed.querySelector('parsererror') || parsed.documentElement.localName !== 'svg')
+            throw new Error('SVG 尚未完整或格式有误，请检查闭合标签。');
+        // Standalone SVG often omits xmlns in model output. Set it before serialization.
+        const input = parsed.documentElement;
+        if (input.namespaceURI && input.namespaceURI !== 'http://www.w3.org/2000/svg')
+            throw new Error('SVG 命名空间无效。');
+        input.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
+        const fragment = DOMPurify.sanitize(new XMLSerializer().serializeToString(input), {
+            USE_PROFILES: { svg: true, svgFilters: true },
+            ADD_TAGS: ['use', 'animate'],
+            FORBID_TAGS: ['script', 'foreignObject', 'a', 'image', 'feImage', 'set'],
+            RETURN_DOM_FRAGMENT: true
+        });
+        const svg = fragment.querySelector('svg');
+        if (!svg) throw new Error('没有可预览的 SVG。');
+        const local = /^#[\w.:-]+$/;
+        const presentation = new Set([...SafeSvg.properties,
+            'stop-color', 'stop-opacity', 'flood-color', 'flood-opacity',
+            'clip-path', 'mask', 'filter', 'transform', 'transform-origin', 'vector-effect']);
+        const safeValue = (value) => !/[\\<>@]/.test(value) &&
+            !/(?:var|attr|expression|image)\s*\(/i.test(value) &&
+            (!/url\s*\(/i.test(value) || /^url\(["']?#[\w.:-]+["']?\)$/i.test(value.trim()));
+        const declarations = (style) => [...style]
+            .filter(name => presentation.has(name) && safeValue(style.getPropertyValue(name)))
+            .map(name => name + ':' + style.getPropertyValue(name)).join(';');
+        for (const style of svg.querySelectorAll('style')) {
+            const sheet = new CSSStyleSheet();
+            sheet.replaceSync(style.textContent);
+            style.textContent = [...sheet.cssRules]
+                .filter(rule => rule.type === CSSRule.STYLE_RULE)
+                .map(rule => rule.selectorText + '{' + declarations(rule.style) + '}').join('\n');
+        }
+        const animated = new Set([...presentation, 'x', 'y', 'x1', 'y1', 'x2', 'y2',
+            'cx', 'cy', 'r', 'rx', 'ry', 'd', 'points', 'width', 'height', 'viewBox']);
+        for (const node of [svg, ...svg.querySelectorAll('*')]) {
+            if (node.hasAttribute('style')) {
+                const value = declarations(node.style);
+                node.removeAttribute('style');
+                if (value) node.setAttribute('style', value);
+            }
+            for (const attr of [...node.attributes]) {
+                if (attr.localName === 'href' && !local.test(attr.value)) node.removeAttributeNode(attr);
+                else if (/^on/i.test(attr.name) || attr.localName === 'base' ||
+                    (attr.name !== 'style' && !safeValue(attr.value))) node.removeAttributeNode(attr);
+            }
+            // Animations may change only visual attributes, never URLs or event handlers.
+            if (/^(animate|animateTransform|animateMotion)$/.test(node.localName) &&
+                ((node.localName !== 'animateMotion' && !animated.has(node.getAttribute('attributeName'))) ||
+                 ['values', 'from', 'to', 'by'].some(name => /url\s*\(|[\\<>@]/i.test(node.getAttribute(name) || ''))))
+                node.remove();
+        }
+        const viewBox = (svg.getAttribute('viewBox') || '').trim().split(/[\s,]+/).map(Number);
+        const validBox = viewBox.length === 4 && viewBox.every(Number.isFinite) && viewBox[2] > 0 && viewBox[3] > 0;
+        const dimension = (name, fallback) => {
+            const value = svg.getAttribute(name) || '';
+            const number = Number.parseFloat(value);
+            return /^\d+(?:\.\d+)?(?:px)?$/.test(value) && number > 0 ? number : fallback;
+        };
+        const width = validBox ? viewBox[2] : dimension('width', 800);
+        const height = validBox ? viewBox[3] : dimension('height', 600);
+        if (width > 100000 || height > 100000 || width / height > 1000 || height / width > 1000)
+            throw new Error('SVG 画布尺寸过大，请调整 viewBox。');
+        if (!validBox) svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
+        svg.setAttribute('width', width);
+        svg.setAttribute('height', height);
+        const text = new XMLSerializer().serializeToString(svg);
+        return { text, width, height, title: svg.querySelector('title')?.textContent || 'SVG 图形',
+            url: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(text) };
+    },
+    async image(prepared) {
+        const img = new Image();
+        img.alt = prepared.title;
+        img.draggable = false;
+        img.src = prepared.url;
+        await img.decode();
+        return img;
+    },
+    async png(prepared) {
+        const img = await this.image(prepared);
+        const scale = Math.min(2, 4096 / prepared.width, 4096 / prepared.height,
+            Math.sqrt(16000000 / (prepared.width * prepared.height)));
+        const canvas = document.createElement('canvas');
+        canvas.width = Math.max(1, Math.round(prepared.width * scale));
+        canvas.height = Math.max(1, Math.round(prepared.height * scale));
+        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
+        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+        if (!blob) throw new Error('图片导出失败，请下载 SVG。');
+        downloadBlob(blob, 'graphic.png');
+    },
+    async render(node, source, alive) {
+        const card = Artifacts.card({ title: 'SVG 图形', className: 'svg-card' });
+        const { container } = card;
+        container.dataset.state = 'loading';
+        const sourceBox = document.createElement('div');
+        sourceBox.className = 'artifact-source';
+        sourceBox.hidden = true;
+        const pre = document.createElement('pre');
+        pre.textContent = source;
+        sourceBox.append(pre);
+        const preview = document.createElement('div');
+        preview.className = 'svg-preview';
+        const loading = Artifacts.loading();
+        loading.textContent = '正在加载 SVG';
+        const toggle = card.menu.add('查看源码', () => {
+            sourceBox.hidden = !sourceBox.hidden;
+            toggle.lastChild.textContent = sourceBox.hidden ? '查看源码' : '收起源码';
+            if (!sourceBox.hidden) sourceBox.scrollIntoView({ block: 'nearest' });
+        }, 'code');
+        card.menu.add('复制源码', () => copyToClipboard(source).then(() => showToast('源码已复制')), 'copy');
+        card.menu.add('下载源码', () => downloadBlob(new Blob([source], { type: 'text/plain;charset=utf-8' }), 'graphic.svg.txt'), 'code');
+        container.append(loading, preview, sourceBox);
+        node.parentElement.replaceWith(container);
+        try {
+            const prepared = this.prepare(source);
+            const img = await this.image(prepared);
+            if (!alive()) return;
+            loading.remove();
+            preview.append(img);
+            container.dataset.state = 'ready';
+            const expand = () => showSvgOverlay(prepared, card.menu);
+            preview.onclick = expand;
+            card.expand(expand);
+            card.menu.add('下载 SVG', () => downloadBlob(new Blob([prepared.text], { type: 'image/svg+xml;charset=utf-8' }), 'graphic.svg'));
+            card.menu.add('导出 PNG', () => this.png(prepared));
+        } catch (error) {
+            if (!alive()) return;
+            loading.remove();
+            container.dataset.state = 'error';
+            const message = document.createElement('p');
+            message.className = 'artifact-error error';
+            message.textContent = 'SVG 无法预览：' + error.message;
+            preview.append(message);
+            sourceBox.hidden = false;
+            toggle.hidden = true;
+        }
+    }
+};
